{
  "name": "dedal",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter fest-app-backend dev",
    "dev:frontend": "pnpm --filter management-frontend dev",
    "dev": "pnpm -r --parallel dev",
    "build:frontend": "pnpm --filter management-frontend build",
