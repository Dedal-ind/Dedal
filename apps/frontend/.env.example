# Dedal frontend environment. Copy to `.env` and fill in real values.

# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Razorpay public key id (embedded in the browser Checkout).
VITE_RAZORPAY_KEY_ID=

# Application environment label. Set to "staging" to show a sticky banner.
# Omit or leave empty in production.
VITE_APP_ENVIRONMENT=

# Google Sign-In needs NO frontend variable: the sign-in screen fetches the
# client id from GET /api/v1/authentication/google/config, served from the
# backend's GOOGLE_CLIENT_ID — one source of truth, so the audience the browser
# mints tokens for can never diverge from what the backend verifies.
#
# Google Cloud Console setup (one time, backend-side value):
#   1. APIs & Services → Credentials → Create OAuth client ID → Web application.
#   2. Add Authorized JavaScript origins:
#        http://localhost:5173   (Vite dev — add the exact port you run on)
#        https://<your-production-domain>
#      (No redirect URI is needed — Google Identity Services uses the origin.)
#   3. Put the generated Client ID in the BACKEND's GOOGLE_CLIENT_ID only.
