{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "no-console": ["warn", {
      "allow": ["error"]
    }],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-undef": "error",
    "camelcase": ["error", {
      "properties": "never",
      "ignoreDestructuring": false
    }],
    "id-length": ["warn", {
      "min": 2,
      "exceptions": ["_"]
    }]
  }
}
