APPLICATION_PORT=5000
APPLICATION_ENVIRONMENT=development
DATABASE_URI=mongodb+srv://REPLACE_ME.mongodb.net/festAppMvp

# Reverse-proxy hops to trust for client IP. Integer only, never `true`.
# Omit to default: 0 in development, 1 in production.
TRUST_PROXY_HOPS=0

JWT_SECRET=REPLACE_ME_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRY_DAYS=30

# Google Sign-In (optional). The OAuth 2.0 *Web application* Client ID from the
# Google Cloud Console. Public value — safe to commit and to ship to the browser.
# Leave blank to disable Google sign-in (the app still boots and signs in by OTP).
# Must be the SAME value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=REPLACE_ME_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Delivery goes through Resend's HTTP API. RESEND_API_KEY is what SELECTS the
# transport:
#   set                                 -> real delivery, in any environment
#   unset + APPLICATION_ENVIRONMENT=development -> console driver, mail printed
#                                          to the terminal (OTP codes readable)
#   unset + production                  -> no transport; sends fail and the
#                                          server warns loudly at boot
# Verify `npm run test:email -- you@example.com` before trusting a new install.
RESEND_API_KEY=

# The sender. Its DOMAIN must be verified in Resend, or Resend rejects the send.
# Resend's onboarding@resend.dev works without a verified domain, but only
# delivers to the address that owns the Resend account — fine for a smoke test,
# useless for real users.
EMAIL_FROM_ADDRESS=REPLACE_ME@your-verified-domain.com

# Optional display name, folded into "Name <address>" at send time. Ignored if
# EMAIL_FROM_ADDRESS already carries its own display name.
EMAIL_FROM_NAME=Dedal

# Sign-in link placed in staff assignment emails.
FRONTEND_BASE_URL=http://localhost:5173

# The single admin the dev seed provisions (`npm run db:seed:test`). Exactly one
# email — validated on boot; a comma-separated list fails fast.
SEED_ADMIN_EMAIL=admin@gmail.com

# ── File uploads ────────────────────────────────────────────────────────────
# Base URL the server serves local uploads back from. Only matters for the
# default local-disk driver; leave as your backend origin.
BACKEND_BASE_URL=http://localhost:5000

# Optional S3 configuration — if unset, uploads use local disk (the default).
# S3 activates ONLY when S3_BUCKET_NAME, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY
# are all set. See docs/S3_SETUP.md. Do NOT put real credentials here — real
# values go in .env (gitignored); this file is documentation only.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_UPLOAD_URL_EXPIRY_SECONDS=3600

# First platform admin bootstrap (npm run bootstrap:first-platform-admin)
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_NAME=Platform Admin

# ── Staging safety ─────────────────────────────────────────────────────────
# Comma-separated email addresses that MAY receive real email in staging.
# Every other address is silently suppressed (logged, not sent). If unset or
# empty, ALL outbound email is suppressed — fail closed.
# Only takes effect when APPLICATION_ENVIRONMENT=staging.
STAGING_EMAIL_ALLOWLIST=

# The PRODUCTION S3 bucket name, used only in staging to verify that the
# staging bucket differs from production. If S3 is configured in staging and
# this is unset, the backend refuses to boot — the check cannot be silently
# skipped. Has no effect in development or production.
PRODUCTION_S3_BUCKET_NAME=
